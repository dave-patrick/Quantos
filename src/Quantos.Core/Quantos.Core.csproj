<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.58.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- A private Google Cloud client for the optional Google Tasks sync. The file is git-ignored; when it exists the build embeds it,
       so Settings shows a plain Connect button. Without it, people paste their own client (see documentation/GOOGLE-TASKS-SYNC-DESIGN.md). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../build/google-client.json')">
    <EmbeddedResource Include="../../build/google-client.json" LogicalName="google-client.json" />
  </ItemGroup>

</Project>
