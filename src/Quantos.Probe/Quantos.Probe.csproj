<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage 1 laptop test: checks that a portable Quantos build can run on a managed PC without admin rights. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WebView2's package also ships a WPF assembly we don't use; its WindowsBase version note is harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <AssemblyName>Quantos.Probe</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- PowerShell needs real files on disk; this also tests whether extracted files are allowed to load. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- Pin patched versions of PowerShell's crypto dependencies (10.0.10 has known advisories). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
