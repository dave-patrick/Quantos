<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>quantos-cli</AssemblyName>
    <RootNamespace>Quantos.Cli</RootNamespace>
    <Product>Quantos</Product>
    <Company>Atomic 22 Industries</Company>
    <Version>0.1.5.7</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tool schemas live with the domain code, but the CLI stays a thin client: it compiles
         the same file rather than taking a reference on the whole library. -->
    <Compile Include="..\Quantos.Core\Agents\McpTools.cs" Link="Agents\McpTools.cs" />
  </ItemGroup>

</Project>
