<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.atomic22.quantos</ApplicationId>
    <ApplicationTitle>Quantos</ApplicationTitle>
    <RootNamespace>Quantos.Mobile</RootNamespace>
    <ApplicationVersion>202</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.2</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="SharedAspNet.targets" />
  <ItemGroup>
    <Compile Include="MainActivity.cs" />
    <Compile Include="AndroidKeyProtector.cs" />
    <Compile Include="AndroidTerminal.cs" />
    <Compile Include="AndroidPdf.cs" />
    <ProjectReference Include="Backend/Quantos.Android.Backend.csproj" />
  </ItemGroup>
</Project>
