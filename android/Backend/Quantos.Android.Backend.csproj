<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Quantos.Android.Backend</AssemblyName>
    <RootNamespace>Quantos.Backend</RootNamespace>
    <Version>0.2.2</Version>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="../SharedAspNet.targets" />
  <ItemGroup>
    <ProjectReference Include="../../src/Quantos.Core/Quantos.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <Compile Include="../../src/Quantos.Backend/**/*.cs" Exclude="../../src/Quantos.Backend/bin/**;../../src/Quantos.Backend/obj/**" />
    <Compile Include="GlobalUsings.cs" />
    <EmbeddedResource Include="../../src/Quantos.Backend/wwwroot/**">
      <Link>$([System.IO.Path]::Combine('wwwroot', '%(RecursiveDir)%(Filename)%(Extension)'))</Link>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="VerifyAndroidFrontend" AfterTargets="_GenerateEmbeddedFilesManifest">
    <XmlPeek XmlInputPath="$(_GeneratedManifestFile)" Query="/Manifest/FileSystem/Directory[@Name='wwwroot']/File[@Name='index.html']/ResourcePath/text()">
      <Output TaskParameter="Result" PropertyName="_AndroidIndexResource" />
    </XmlPeek>
    <Error Condition="'$(_AndroidIndexResource)' == ''" Text="The embedded Android frontend has no wwwroot/index.html. Clean the generated manifest and rebuild before packaging." />
  </Target>
</Project>
